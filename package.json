{
  "name": "dsh-view-switcher",
  "version": "0.5.3",
  "description": "View switcher + element inspector plugin for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/client.test.js",
    "smoke": "node --test --test-isolation=none test/client.test.js",
    "demo": "node demo/prepare.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bizzgitajatin/dsh-view-switcher.git"
  },
  "homepage": "https://github.com/bizzgitajatin/dsh-view-switcher#readme",
  "bugs": {
    "url": "https://github.com/bizzgitajatin/dsh-view-switcher/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "view-switcher",
    "inspector"
  ],
  "license": "MIT"
}
